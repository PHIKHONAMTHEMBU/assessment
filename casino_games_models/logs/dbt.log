[0m21:51:33.388483 [debug] [Thread-1 (]: On model.casino_games_models.gl_activity: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "casino_games_models", "target_name": "dev", "node_id": "model.casino_games_models.gl_activity"} */

  
  create view "dev"."main"."gl_activity__dbt_tmp" as (
    with currency as (
    select * from "dev"."main"."slv_dim_currency"
),
activity as (
    select * from "dev"."main"."slv_fact_activity"
)

select  
        act.activity_date, 
        act.casino_id, 
        act.player_id, 
        act.game_id, 
        act.total_spins, 
        act.goline_date,
        act.total_wager * cur.currency_rate as total_wager_rated, -- converting to provided rates
        act.total_payout * cur.currency_rate as total_payout,   -- converting to provided rates
        (act.total_wager * cur.currency_rate) - act.total_payout * cur.currency_rate as net_wins -- calculating total wins

from    activity act
left outer join 
        currency cur
on      act.currency_id =  cur.currency_id
  );

