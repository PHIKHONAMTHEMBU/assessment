    select * from "dev"."main"."br_fact_activity"

)
select  
        
        CASINOID as casino_id,
        PLAYERID as player_id,
        GAMEID as game_id,
        CURRENCYID as currency_id, 

        -- handling transformation of financial data
        cast(TOTALWAGER as double) as total_wager, 
        cast(TOTALPAYOUT as double) as total_payout,
        cast(TOTALSPINS as double) as total_spins,
        
        -- converting dates  
        cast(GOLIVE_DATE as date) as goline_date,
        cast(date as date)  as activity_date
from    slv_fact_activity
  );

